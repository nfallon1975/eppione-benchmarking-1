generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
  BROKER
}

enum RelationshipStatus {
  UPLOADED
  INVITED
  ACTIVE
  REVOKED
}

enum AccessLevel {
  VIEW_ONLY
  VIEW_AND_ADVISE
}

enum RequirementType {
  MANDATORY
  QUASI_MANDATORY
  RECOMMENDED
  COMMON_PRACTICE
}

enum LimitType {
  TAX_RELIEF_CAP
  CONTRIBUTION_LIMIT
  INSURABLE_EARNINGS_CEILING
  SOCIAL_SECURITY_CAP
  BENEFIT_IN_KIND_THRESHOLD
  OTHER
}

enum ComplianceStatus {
  COMPLIANT
  NON_COMPLIANT
  PARTIALLY_COMPLIANT
  NOT_APPLICABLE
  UNKNOWN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyRole {
  OWNER
  CONTRIBUTOR
  VIEWER
}

enum BenefitCategory {
  HEALTH
  LIFE
  DISABILITY
  PENSION
  DENTAL
  VISION
  EAP
  WELLNESS
  INCOME_PROTECTION
  CRITICAL_ILLNESS
  TRAVEL
  MEAL_VOUCHERS
  TRANSPORT
  CHILDCARE
  EDUCATION
  ANNUAL_LEAVE
  SICK_PAY
  MATERNITY_PAY
  PATERNITY_PAY
  OTHER
}

enum PlatformType {
  FLEX_BENEFITS
  TOTAL_REWARD
  VOLUNTARY
  DISCOUNT
  WELLBEING
  OTHER
}

enum FeeModel {
  PER_EMPLOYEE_PER_MONTH
  PER_EMPLOYEE_PER_YEAR
  FLAT_FEE
  PERCENTAGE
  OTHER
}

enum SurveyStatus {
  DRAFT
  SUBMITTED
}

enum SalaryBand {
  UNDER_35K
  BAND_35K_50K
  BAND_50K_75K
  BAND_75K_100K
  OVER_100K
}

enum PlanType {
  DC
  DB
  CASH_BALANCE
  HYBRID
}

enum DeathBenefitType {
  ACCUMULATED_RESERVES
  FIXED_MULTIPLE
  MIXED
  NONE
}

enum PensionFormulaType {
  FLAT_RATE
  STEP_RATE
  SALARY_LINKED
  OTHER
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String?
  name           String?
  role           UserRole     @default(CLIENT)
  status         UserStatus   @default(PENDING)
  companyRole    CompanyRole?
  emailVerified  DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil    DateTime?
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id])
  accounts                Account[]
  sessions                Session[]
  brokerProfile           BrokerProfile?
  brokerClients           BrokerClientRelationship[] @relation("BrokerRelationships")
  contributedRequirements CountryBenefitRequirement[]
  contributedLimits       CountryStatutoryLimit[]
  apiKeys                 ApiKey[]
  baselineImports         BaselineDataSource[] @relation("BaselineImporter")
  addedSources            DataSourceReference[] @relation("SourceAdder")
  verifiedSources         DataSourceReference[] @relation("SourceVerifier")
  reviewCyclesRun         MonthlyReviewCycle[]  @relation("ReviewRunner")
  reviewedFindings        MonthlyReviewFinding[] @relation("FindingReviewer")
  dataPointChanges        DataPointHistory[]    @relation("HistoryChanger")
  notifications           Notification[]
  pdfIngestions           PDFIngestion[]    @relation("PDFUploader")
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@index([email])
  @@index([companyId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id                    String          @id @default(cuid())
  name                  String
  country               String          // ISO 3166-1 alpha-2
  industry              String          // NACE/ISIC classification code
  employeeCount         Int
  averageSalary         Float?
  averageSalaryCurrency String?
  averageBonus          Float?
  averageBonusCurrency  String?
  financialYearEndMonth Int?            // 1-12
  employeeCountRange    String?         // "1-50", "51-250", etc.
  averageBonusPercent   Float?          // bonus as % of salary
  surveyCompletedAt     DateTime?
  benefitBudget         Float?
  benefitBudgetCurrency String          @default("EUR")
  averageWorkforceAge   Float?
  desiredNewBenefits    String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  users                 User[]
  benefitEntries        BenefitEntry[]
  platformInfo          PlatformInfo[]
  surveyDraft           SurveyDraft?
  categoryExclusions    CategoryExclusion[]
  countryProfiles       CompanyCountryProfile[]
  complianceResults     ComplianceCheckResult[]
  brokerRelationships   BrokerClientRelationship[]

  @@index([country])
  @@index([industry])
}

model CompanyCountryProfile {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  country               String   // ISO 3166-1 alpha-2
  employeeCountRange    String?
  averageSalary         Float?
  averageSalaryCurrency String?
  averageBonusPercent   Float?
  financialYearEndMonth Int?     // 1-12
  salaryBand            SalaryBand?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId, country])
  @@index([companyId])
}

model BenefitEntry {
  id                          String          @id @default(cuid())
  companyId                   String
  company                     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  benefitCategory             BenefitCategory
  country                     String          @default("")
  benefitName                 String
  coverLevel                  String          // e.g. "2x salary", "€50,000", "75% of salary"
  employerFunded              Boolean         @default(true)
  employeeContributionPercent Float?
  coversSpouse                Boolean         @default(false)
  coversDependents            Boolean         @default(false)
  maxDependents               Int?
  isCore                      Boolean         @default(true)
  isVoluntary                 Boolean         @default(false)
  isFlexible                  Boolean         @default(false)
  flexFundAmount              Float?
  flexFundCurrency            String?
  surveySource                Boolean         @default(false)
  provider                    String?
  annualCostPerEmployee       Float?
  costCurrency                String          @default("EUR")
  notes                       String?
  healthExcess                Float?
  healthExcessCurrency        String          @default("EUR")
  healthCopayPercent          Float?          // 0-100
  healthInpatientLimit        Float?
  healthOutpatientLimit       Float?
  healthLimitCurrency         String          @default("EUR")
  // Life Insurance / Death in Service
  lifeCoverMultiple           Float?
  lifeFixedCoverAmount        Float?
  lifeCoverAmountCurrency     String          @default("EUR")
  lifeFreeCoverLimit          Float?
  // Income Protection
  ipBenefitPercent            Float?
  ipWaitingPeriodWeeks        Int?
  ipMaxBenefitAge             Int?
  // Critical Illness
  ciCoverMultiple             Float?
  ciFixedCoverAmount          Float?
  ciCoverAmountCurrency       String          @default("EUR")
  // Dental
  dentalAnnualLimit           Float?
  dentalAnnualLimitCurrency   String          @default("EUR")
  dentalOrthoIncluded         Boolean?
  // Pension
  pensionEmployerPct          Float?
  pensionEmployeePct          Float?
  pensionPlanType             PlanType?
  pensionContributionRateEmployer  Float?    // percentage
  pensionContributionRateEmployee  Float?    // percentage, nullable
  pensionDeathBenefitMultiple Float?          // e.g. 2.0 for "2x salary"
  pensionDeathBenefitType     DeathBenefitType?
  pensionFormulaType          PensionFormulaType?
  // Annual Leave
  leaveDaysEntitlement        Int?
  leaveIncludesPublicHolidays Boolean?
  leaveIncreasesWithTenure    Boolean?
  leaveMaxDays                Int?            // max days after tenure increases
  leaveBuySellDays            Boolean?
  leaveCarryOverDays          Int?            // days that can be carried over
  leaveBirthdayOff            Boolean?
  leaveVolunteerDays          Int?            // volunteer/charity days per year
  leaveChristmasClosureDays   Int?            // company closure days at year end
  // Sick Pay
  sickPayFullPayWeeks         Int?
  sickPayHalfPayWeeks         Int?
  sickPayPartialPayPercent    Float?          // partial pay rate if not 50%
  sickPayWaitingDays          Int?            // waiting days before sick pay starts
  sickPayAboveStatutory       Boolean?
  // Maternity Pay
  maternityFullPayWeeks       Int?
  maternityPartialPayWeeks    Int?
  maternityPartialPayPercent  Float?
  maternityTotalLeaveWeeks    Int?            // total leave offered (paid + unpaid)
  maternityAboveStatutory     Boolean?
  maternityKitDays            Int?            // Keeping In Touch days
  maternityGradualReturn      Boolean?        // phased return option
  // Paternity Pay
  paternityFullPayWeeks       Int?
  paternityPartialPayWeeks    Int?
  paternityPartialPayPercent  Float?
  paternityTotalLeaveWeeks    Int?            // total leave offered
  paternityAboveStatutory     Boolean?
  paternitySharedParentalLeave Boolean?       // shared parental leave available
  // Broker
  brokerName                  String?
  brokerSatisfactionScore     Int?            // 1-10
  renewalDate                 DateTime?
  benefitSatisfactionScore    Int?            // 1-10
  complianceResults           ComplianceCheckResult[]
  healthLimits                HealthLimit[]
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  @@index([companyId])
  @@index([benefitCategory])
  @@index([companyId, benefitCategory])
  @@index([companyId, country])
  @@index([companyId, country, benefitCategory])
}

model HealthLimit {
  id             String       @id @default(cuid())
  benefitEntryId String
  benefitEntry   BenefitEntry @relation(fields: [benefitEntryId], references: [id], onDelete: Cascade)
  limitType      String       // "INPATIENT", "OUTPATIENT", "DENTAL", "MENTAL_HEALTH", "OPTICAL", "MATERNITY", or custom
  hasLimit       Boolean      // true = capped, false = full cover
  limitAmount    Float?       // only when hasLimit = true
  limitCurrency  String       @default("EUR")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([benefitEntryId, limitType])
  @@index([benefitEntryId])
}

model PlatformInfo {
  id                          String       @id @default(cuid())
  companyId                   String
  company                     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  usesPlatform                Boolean      @default(false)
  platformName                String?
  platformType                PlatformType?
  annualPlatformFee           Float?
  feeCurrency                 String       @default("EUR")
  feeModel                    FeeModel?
  platformSatisfactionScore   Int?         // 1-10
  usesTotalRewardPlatform     Boolean      @default(false)
  totalRewardPlatformName     String?
  otherHRTechPlatforms        String?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  @@index([companyId])
}

model SurveyDraft {
  id          String       @id @default(cuid())
  companyId   String       @unique
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status      SurveyStatus @default(DRAFT)
  currentStep Int          @default(1)
  data        Json
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model CategoryExclusion {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  benefitCategory BenefitCategory
  country         String          @default("")
  isCore          Boolean         // true=core step, false=flex step

  @@unique([companyId, country, benefitCategory, isCore])
  @@index([companyId])
}

model CountryConfig {
  id                      String   @id @default(cuid())
  countryCode             String   @unique // ISO 3166-1 alpha-2
  countryName             String
  currency                String
  availableBenefitCategories BenefitCategory[]
  regulatoryNotes         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([countryCode])
}

model CurrencyRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
}

model BrokerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  licenseNumber   String?
  countriesActive String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BrokerClientRelationship {
  id          String             @id @default(cuid())
  brokerId    String
  broker      User               @relation("BrokerRelationships", fields: [brokerId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status      RelationshipStatus @default(INVITED)
  invitedAt   DateTime           @default(now())
  acceptedAt  DateTime?
  inviteEmail String
  inviteToken String             @unique
  accessLevel AccessLevel        @default(VIEW_ONLY)
  countries   String[]            // ISO 3166-1 alpha-2 codes; empty = all countries

  @@unique([brokerId, companyId])
  @@index([brokerId])
  @@index([companyId])
  @@index([inviteToken])
}

model CountryBenefitRequirement {
  id                      String          @id @default(cuid())
  country                 String
  benefitCategory         BenefitCategory
  requirementType         RequirementType
  description             String
  minimumLevel            String?
  legalReference          String?
  effectiveFrom           DateTime
  effectiveTo             DateTime?
  penaltyForNonCompliance String?
  notes                   String?
  contributedById         String
  contributedBy           User            @relation(fields: [contributedById], references: [id])
  verifiedByAdmin         Boolean         @default(false)
  complianceResults       ComplianceCheckResult[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([country])
  @@index([country, benefitCategory])
  @@index([contributedById])
}

model CountryStatutoryLimit {
  id              String          @id @default(cuid())
  country         String
  limitType       LimitType
  benefitCategory BenefitCategory?
  description     String
  limitValue      String
  currency        String?
  taxYear         String
  legalReference  String?
  contributedById String
  contributedBy   User            @relation(fields: [contributedById], references: [id])
  verifiedByAdmin Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([country])
  @@index([country, taxYear])
  @@index([contributedById])
}

model ComplianceCheckResult {
  id              String                    @id @default(cuid())
  companyId       String
  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  country         String
  benefitEntryId  String?
  benefitEntry    BenefitEntry?             @relation(fields: [benefitEntryId], references: [id], onDelete: SetNull)
  requirementId   String
  requirement     CountryBenefitRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  status          ComplianceStatus
  gap             String?
  recommendation  String?
  checkedAt       DateTime                  @default(now())

  @@index([companyId])
  @@index([companyId, country])
  @@index([requirementId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([keyPrefix])
}

model ReferenceBenchmark {
  id                        String          @id @default(cuid())
  country                   String          // ISO 3166-1 alpha-2
  benefitCategory           BenefitCategory
  prevalencePercent         Float           // 0-100
  costAvg                   Float?
  costMedian                Float?
  costP25                   Float?
  costP75                   Float?
  costCurrency              String          @default("EUR")
  typicalEmployerContribPct Float?
  typicalEmployeeContribPct Float?
  pctEmployerFunded         Float?          // 0-100
  pctCoversSpouse           Float?          // 0-100
  pctCoversDependents       Float?          // 0-100
  // Health-specific
  healthExcess              Float?
  healthCopayPercent        Float?
  healthInpatientLimit      Float?
  healthOutpatientLimit     Float?
  // Life-specific
  lifeCoverMultiple         Float?
  // Income Protection-specific
  ipBenefitPercent          Float?
  ipWaitingPeriodWeeks      Int?
  // Pension-specific
  pensionEmployerPct        Float?
  pensionEmployeePct        Float?
  // Metadata
  confidenceLevel           String?         // "HIGH", "MEDIUM", "LOW"
  coverageNotes             String?         @db.Text
  sourceDescription         String?         @db.Text
  sourceUrls                String[]
  generatedAt               DateTime        @default(now())
  verifiedByAdmin           Boolean         @default(false)
  publishedAt               DateTime?
  lastReviewedAt            DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  @@unique([country, benefitCategory])
  @@index([country])
}

// ── Source Referencing & Data Confidence ──

enum SourceType {
  LEGISLATION
  GOVERNMENT_REPORT
  INDUSTRY_SURVEY
  INSURER_REPORT
  CONSULTANCY_REPORT
  TRADE_BODY
  REGULATOR_PUBLICATION
  NEWS_ARTICLE
  ACADEMIC_PAPER
  EMPLOYER_ASSOCIATION
  TAX_AUTHORITY
  OTHER
}

enum SourceReliability {
  OFFICIAL
  HIGH
  MEDIUM
  LOW
  UNVERIFIED
}

enum LinkedDataType {
  BASELINE_BENCHMARK
  COMPLIANCE_REQUIREMENT
  STATUTORY_LIMIT
  BROKER_CONTRIBUTION
}

enum SourceRelevance {
  PRIMARY
  SUPPORTING
  CROSS_REFERENCE
}

enum FindingType {
  VALUE_CHANGED
  NEW_DATA_AVAILABLE
  SOURCE_EXPIRED
  SOURCE_UPDATED
  CONFLICTING_DATA
  NEW_REGULATION
  DATA_CONFIRMED
  SOURCE_UNAVAILABLE
  NEW_SOURCE_DISCOVERED
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  DEFERRED
}

enum ReviewCycleStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ChangeType {
  CREATED
  UPDATED
  SOURCE_ADDED
  SOURCE_REMOVED
  CONFIDENCE_RECALCULATED
  VERIFIED
  FLAGGED
  DEACTIVATED
}

model DataSourceReference {
  id                    String            @id @default(cuid())
  type                  SourceType
  title                 String
  publisher             String
  country               String?
  url                   String?
  publicationDate       DateTime?
  accessDate            DateTime          @default(now())
  isPubliclyAccessible  Boolean           @default(true)
  summary               String            @db.Text
  reliability           SourceReliability @default(UNVERIFIED)
  isActive              Boolean           @default(true)
  addedById             String
  addedBy               User              @relation("SourceAdder", fields: [addedById], references: [id])
  lastVerifiedAt        DateTime?
  lastVerifiedById      String?
  lastVerifiedBy        User?             @relation("SourceVerifier", fields: [lastVerifiedById], references: [id])
  verificationNotes     String?           @db.Text
  sourceLinks           DataPointSourceLink[]
  reviewFindings        MonthlyReviewFinding[] @relation("FindingSource")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([country])
  @@index([type])
  @@index([reliability])
}

model DataPointSourceLink {
  id                String              @id @default(cuid())
  sourceId          String
  source            DataSourceReference @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  linkedType        LinkedDataType
  linkedId          String
  relevance         SourceRelevance     @default(PRIMARY)
  specificCitation  String?             @db.Text
  extractedValue    String?
  notes             String?             @db.Text
  createdAt         DateTime            @default(now())

  @@index([sourceId])
  @@index([linkedType, linkedId])
}

model DataConfidenceScore {
  id                  String    @id @default(cuid())
  linkedType          LinkedDataType
  linkedId            String
  overallConfidence   Float
  recencyScore        Float
  sourceQualityScore  Float
  corroborationScore  Float
  consistencyScore    Float
  calculatedAt        DateTime  @default(now())
  calculationMethod   String    // "AI_REVIEW", "MANUAL", "SYSTEM"
  reasoning           String?   @db.Text
  flagged             Boolean   @default(false)
  flagReason          String?   @db.Text

  @@unique([linkedType, linkedId])
  @@index([linkedType, linkedId])
  @@index([flagged])
}

model MonthlyReviewCycle {
  id                       String              @id @default(cuid())
  month                    String              // "2026-03"
  status                   ReviewCycleStatus   @default(SCHEDULED)
  startedAt                DateTime?
  completedAt              DateTime?
  countriesReviewed        String[]
  totalDataPointsReviewed  Int                 @default(0)
  totalUpdatesFound        Int                 @default(0)
  totalFlagsRaised         Int                 @default(0)
  totalSourcesChecked      Int                 @default(0)
  newSourcesDiscovered     Int                 @default(0)
  aiCostEstimate           Float?
  runById                  String?
  runBy                    User?               @relation("ReviewRunner", fields: [runById], references: [id])
  summary                  String?             @db.Text
  findings                 MonthlyReviewFinding[]
  dataPointHistories       DataPointHistory[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@unique([month])
  @@index([status])
}

model MonthlyReviewFinding {
  id                  String              @id @default(cuid())
  reviewCycleId       String
  reviewCycle         MonthlyReviewCycle   @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  findingType         FindingType
  country             String
  benefitCategory     BenefitCategory?
  industry            String?
  linkedType          LinkedDataType?
  linkedId            String?
  currentValue        String?
  suggestedValue      String?
  sourceReferenceId   String?
  sourceReference     DataSourceReference? @relation("FindingSource", fields: [sourceReferenceId], references: [id])
  newSourceUrl        String?
  confidence          Float
  severity            FindingSeverity
  aiReasoning         String              @db.Text
  status              FindingStatus       @default(PENDING_REVIEW)
  reviewedById        String?
  reviewedBy          User?               @relation("FindingReviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  reviewNotes         String?             @db.Text
  createdAt           DateTime            @default(now())

  @@index([reviewCycleId])
  @@index([status])
  @@index([severity])
  @@index([country])
}

model DataPointHistory {
  id              String    @id @default(cuid())
  linkedType      LinkedDataType
  linkedId        String
  changeType      ChangeType
  previousValue   String?
  newValue        String?
  changedById     String?
  changedBy       User?     @relation("HistoryChanger", fields: [changedById], references: [id])
  changeSource    String    // "MANUAL", "PDF_IMPORT", "MONTHLY_REVIEW", "BROKER_CONTRIBUTION", "ADMIN_EDIT"
  reviewCycleId   String?
  reviewCycle     MonthlyReviewCycle? @relation(fields: [reviewCycleId], references: [id])
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([linkedType, linkedId])
  @@index([reviewCycleId])
}

// ── Notifications ──

enum NotificationType {
  REVIEW_CRITICAL
  REVIEW_HIGH
  REVIEW_COMPLETE
  REGULATORY_UPDATE
  SOURCE_EXPIRED
  COMPLIANCE_CHANGE
  SYSTEM
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String           @db.Text
  linkUrl     String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ── Review Scheduling ──

model ReviewScheduleConfig {
  id                  String    @id @default("default")
  enabled             Boolean   @default(true)
  dayOfMonth          Int       @default(1)     // 1-28
  priorityCountries   String[]                  // reviewed every month
  secondaryCountries  String[]                  // reviewed quarterly
  monthlyBudgetCap    Float     @default(50)
  lastRunAt           DateTime?
  nextRunAt           DateTime?
  updatedAt           DateTime  @updatedAt
}

// ── PDF Ingestion ──

enum IngestionStatus {
  UPLOADED
  PROCESSING
  REVIEW_READY
  APPROVED
  REJECTED
  ERROR
}

enum ExtractedPointStatus {
  EXTRACTED
  CONFIRMED
  EDITED
  REJECTED
}

model PDFIngestion {
  id                    String           @id @default(cuid())
  filename              String
  fileHash              String?
  filePath              String?          // stored file path
  pageCount             Int?
  uploadedById          String
  uploadedBy            User             @relation("PDFUploader", fields: [uploadedById], references: [id])
  uploadedAt            DateTime         @default(now())
  status                IngestionStatus  @default(UPLOADED)
  sourceCountry         String?
  sourceName            String?
  sourcePublisher       String?
  sourceYear            Int?
  sourceType            BaselineSourceType?
  licenseNotes          String?          @db.Text
  aiExtractionLog       Json?
  reviewNotes           String?          @db.Text
  linkedBaselineSourceId String?
  linkedBaselineSource  BaselineDataSource? @relation(fields: [linkedBaselineSourceId], references: [id])
  extractedPoints       ExtractedDataPoint[]
  errorMessage          String?          @db.Text
  processingCost        Float?
  createdAt             DateTime         @default(now())

  @@index([status])
  @@index([uploadedById])
  @@index([fileHash])
}

model ExtractedDataPoint {
  id                String               @id @default(cuid())
  ingestionId       String
  ingestion         PDFIngestion         @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  pageNumber        Int
  rawText           String               @db.Text
  country           String
  industry          String?
  benefitCategory   BenefitCategory
  metricType        BaselineMetricType
  metricLabel       String
  value             Float
  unit              String
  currency          String?
  percentile25      Float?
  percentile75      Float?
  salaryBand        String?
  companySize       String?
  aiConfidence      Float
  status            ExtractedPointStatus @default(EXTRACTED)
  adminEditedValue  Float?
  notes             String?              @db.Text
  createdAt         DateTime             @default(now())

  @@index([ingestionId])
  @@index([status])
}

enum BaselineSourceType {
  INDUSTRY_SURVEY
  INSURER_REPORT
  GOVERNMENT_DATA
  CONSULTANCY_REPORT
  TRADE_BODY
  OTHER
}

enum BaselineMetricType {
  PREVALENCE
  MEDIAN_CONTRIBUTION_RATE
  AVERAGE_CONTRIBUTION_RATE
  MEDIAN_COST_PER_EMPLOYEE
  AVERAGE_COST_PER_EMPLOYEE
  PLAN_TYPE_SPLIT_DC
  PLAN_TYPE_SPLIT_DB
  DEATH_BENEFIT_MULTIPLE
  EMPLOYER_FUNDING_RATE
  COVER_LEVEL_MEDIAN
  PLATFORM_ADOPTION_RATE
  SPOUSE_COVER_PREVALENCE
  DEPENDENT_COVER_PREVALENCE
  REPLACEMENT_RATIO
  CUSTOM
}

model BaselineDataSource {
  id            String             @id @default(cuid())
  name          String             // e.g. "IAPF Benefits Survey 2024"
  publisher     String             // e.g. "Irish Association of Pension Funds"
  country       String             // ISO code
  year          Int
  sampleSize    Int?
  sourceUrl     String?
  sourceType    BaselineSourceType
  importedAt    DateTime           @default(now())
  importedById  String
  importedBy    User               @relation("BaselineImporter", fields: [importedById], references: [id])
  isActive      Boolean            @default(true)
  notes         String?            @db.Text
  licenseNotes  String             @default("")  @db.Text
  benchmarks    BaselineBenchmark[]
  pdfIngestions PDFIngestion[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([country])
  @@index([country, year])
}

model BaselineBenchmark {
  id              String              @id @default(cuid())
  sourceId        String
  source          BaselineDataSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  country         String
  industry        String?             // null = cross-industry
  industryNACE    String?
  companySize     String?
  salaryBand      String?
  benefitCategory BenefitCategory
  metricType      BaselineMetricType
  metricLabel     String
  value           Float
  unit            String              // "percent", "currency", "multiple", "ratio"
  currency        String?
  percentile25    Float?
  percentile75    Float?
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([sourceId])
  @@index([country, benefitCategory])
  @@index([country, benefitCategory, metricType])
}
